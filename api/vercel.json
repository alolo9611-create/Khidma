{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "regions": ["pdx1"],
  "installCommand": "npm ci --include=dev && npm ci --include=dev --prefix ../web",
  "buildCommand": "npm run build --prefix ../web && rm -rf views && cp -R ../web/dist views",
  "proxy": { "entrypoint": "proxy.ts" }
}
