PORT=3000
JWT_SECRET=dev-only-change-me-to-a-long-random-string
DATABASE_PATH=../db/khidma.sqlite
TIMEZONE=Asia/Riyadh
# Production only (see README "Deploying"):
# NODE_ENV=production
# STATIC_DIR=../web/dist
# TRUST_PROXY=1
# Vercel (see vercel.json): a hosted Turso database instead of DATABASE_PATH, plus the shared preview gate.
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<set in Vercel project settings, never in Git>
# PREVIEW_PASSWORD=<16+ characters, set in Vercel project settings>
